# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_USER=tiger_user
POSTGRES_PASSWORD=tiger_pass
POSTGRES_DB=tiger_intelligence

# ── MinIO / S3-compatible object storage ────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=tiger-images
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_SECURE=false

# ── ML Pipeline ─────────────────────────────────────────────
# production = real CV triage + YOLO tiger detector (fail-closed without weights)
#              + MegaDescriptor identification. Required for real image uploads.
# demo       = hash-seeded simulation ONLY for /api/v1/demo/simulate.
#              Real /images/upload is rejected in demo mode.
ML_MODE=production

# Trained Re-ID checkpoint (file or run directory). Leave empty to probe
# ml/weights/tiger_reid/best.pt, .../latest.pt, then ml/weights/tiger_reid.pt.
REID_CHECKPOINT_PATH=

# Blank image triage thresholds (0.0–1.0)
BLANK_THRESHOLD=0.95

# Tiger Re-ID identity decision thresholds.
# PLACEHOLDERS — not evidence-based. Derive real values for your trained model
# with: python -m ml.reid.calibrate_thresholds --checkpoint ... --data ...
AUTO_MATCH_THRESHOLD=0.90
REVIEW_THRESHOLD=0.75
NEW_INDIVIDUAL_THRESHOLD=0.60
EMBEDDING_DIM=512

# ── Alerting rules ──────────────────────────────────────────
CAMERA_OFFLINE_HOURS=48
HIGH_ACTIVITY_DETECTIONS_PER_DAY=5
LOW_CONFIDENCE_THRESHOLD=0.80

# ── Uploads ─────────────────────────────────────────────────
MAX_UPLOAD_BYTES=15728640
ALLOWED_UPLOAD_EXTENSIONS=.jpg,.jpeg,.png

# ── Geography ───────────────────────────────────────────────
# demo     = simulated Pench boundaries shipped in backend/app/core/geo.py
# official = replace geo.py zones with authoritative GeoJSON before using
GEO_DATA_SOURCE=demo
RESERVE_CENTER_LAT=21.70
RESERVE_CENTER_LON=79.26

# ── Backend ─────────────────────────────────────────────────
SECRET_KEY=changeme-in-production-use-a-long-random-string
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO

# ── Storage paths ───────────────────────────────────────────
# Unset LOCAL_STORAGE_PATH to use <repo>/storage automatically.
QUARANTINE_RETENTION_DAYS=30

# ── Database ────────────────────────────────────────────────
# Unset for the zero-infrastructure SQLite default (<repo>/storage/pench_eye.db).
# docker compose supplies the PostgreSQL + pgvector URLs below.
# DATABASE_URL=postgresql+asyncpg://tiger_user:tiger_pass@localhost:5432/tiger_intelligence
# DATABASE_URL_SYNC=postgresql://tiger_user:tiger_pass@localhost:5432/tiger_intelligence

# ── Frontend ────────────────────────────────────────────────
# Leave empty in development: Vite proxies /api to the backend.
VITE_API_URL=
